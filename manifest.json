{
  "manifest_version": 3,
  "name": "KOAN Plus",
  "version": "1.6.0",
  "description": "Development loader for KOAN Plus. Run npm run build and load dist/ for normal use.",
  "icons": {
    "16": "public/icon-16.png",
    "32": "public/icon-32.png",
    "48": "public/icon-48.png",
    "128": "public/icon-128.png"
  },
  "action": {
    "default_title": "Open KOAN Plus development guide",
    "default_icon": {
      "16": "public/icon-16.png",
      "32": "public/icon-32.png",
      "48": "public/icon-48.png",
      "128": "public/icon-128.png"
    }
  },
  "background": {
    "service_worker": "dev-loader.js"
  }
}
